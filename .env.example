# 服务
APP_NAME=sentiment-analysis-agents
DEBUG=false
HOST=0.0.0.0
PORT=8000

# LLM（LangChain ChatOpenAI，OpenAI 兼容协议，DeepSeek 示例；留空自动使用 MockLLM 离线运行）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096
LLM_MOCK=false

# 数据库（PostgreSQL 主库；可改用 sqlite+aiosqlite:///./sentiment.db 离线）
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sentiment
# MySQL 从库（可选，舆情数据落库）
DATABASE_URL_MYSQL=

# Redis（热点缓存 / 进度快照；未启动自动降级内存）
REDIS_URL=redis://localhost:6379/1

# 任务管控
TASK_QUEUE_SIZE=200
TASK_CONCURRENCY=8
TASK_TIMEOUT_SECONDS=1800

# 可观测（LangSmith 可选）
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=sentiment-analysis-agents
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# 成本估算（元 / 1k tokens）
TOKEN_COST_INPUT_PER_1K=0.001
TOKEN_COST_OUTPUT_PER_1K=0.002

# 评测
EVAL_SET_PATH=data/eval/eval_set.jsonl

# 健壮性（生产保持默认）
# 工具调用失败自动重试次数（0=不重试）
TOOL_RETRIES=1
# Agent 执行失败自动重试次数（0=不重试）
AGENT_RETRIES=1
# 故障注入概率（仅评测/混沌测试使用；生产必须为 0）
FAULT_INJECT_RATE=0.0
AGENT_FAULT_RATE=0.0
